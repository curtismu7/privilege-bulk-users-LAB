# This lab's own settings. Copy this file to `.env` beside docker-compose.yml (mode 600, git-ignored) and fill in only what you need.
# Mock needs none of it: with no .env the lab runs fully offline. Names only here: never put a value in this file, never commit a .env.
# Docker reads .env through compose (an optional env_file); a host run (npm start) reads the same file. Only the names below are read,
# every other key in the file is ignored. BULK_ENV_FILE=/path on a host run points the lab at another file.
#
# Not settings (plain environment variables, with defaults): PORT (7817), PBU_DATA_DIR (.data), PBU_BIND (loopback; the container sets
# its own), PBU_ALLOWED_HOSTS and LAB_ALLOWED_HOSTS (extra Host names to accept). They are not read from .env.

# The owner's opt-in for Real. Anything other than real (or unset) keeps Real refused; the header toggle then stays on Mock.
PRIVILEGE_BULK_MODE=

# PingOne region suffix of the token and API hosts: com, eu, asia, ca, com.au or sg.
BULK_P1_REGION=
# Id of the PingOne environment where the people are (the source).
BULK_P1_SOURCE_ENV_ID=
# Id of Privilege's own PingOne environment (it may be the same as the source).
BULK_P1_PRIVILEGE_ENV_ID=
# Client id of the PingOne worker app (it needs the Identity Data Admin role on Privilege's environment).
BULK_P1_WORKER_CLIENT_ID=
# Client secret of the worker app. Write-only: never returned, logged or audited.
BULK_P1_WORKER_CLIENT_SECRET=
# Name of the Privilege group the people are added to.
BULK_P1_GROUP=
# Optional: id of the worker app's home environment (the default is the source environment).
BULK_P1_WORKER_ENV_ID=

# Route B: origin of the Privilege console, https (http only for a loopback address), no path.
BULK_CONSOLE_URL=
# Route B: the Privilege tenant id.
BULK_CONSOLE_TENANT=
# Route B: the console user API key.
BULK_CONSOLE_API_KEY=
# Route B: the console user API secret. Write-only: never returned, logged or audited.
BULK_CONSOLE_API_SECRET=
# Optional, Route B: 1 accepts a self-signed console certificate (the local desktop console). Leave empty for a cloud console.
BULK_CONSOLE_INSECURE_TLS=
